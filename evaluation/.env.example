# --- LLM provider credentials ---------------------------------------------
# Required if you use a GPT model
OPENAI_API_KEY=

# Required if you use a Gemini model
GEMINI_API_KEY=

# Required if you use a Mistral / Pixtral model
MISTRAL_API_KEY=

# --- Ollama backend selection ---------------------------------------------
# Both can be set. The model name decides per call which client to use:
#   - Cloud models (listed in CLOUD_MODELS in src/hmr/llm.py, or any name
#     ending in '-cloud' / ':cloud') route to https://ollama.com via
#     OLLAMA_API_KEY.
#   - Everything else goes to OLLAMA_HOST (or localhost:11434 if unset).

OLLAMA_API_KEY=
OLLAMA_HOST=

# --- Data / output roots --------------------------------------------------
# Configs interpolate ${DATA_DIR} and ${OUTPUT_DIR}. Set to absolute paths
# on HPC, or just leave the defaults below to run from the repo checkout.

DATA_DIR=./data
OUTPUT_DIR=./output

# --- Optional ---------------------------------------------------------------
# Override location of the human-designed shapes TSV (used for bd_* puzzles)
# HMR_SHAPES_TSV=./data/human_designed_shapes.tsv
